# Bu dosyayı .env.local olarak kopyala ve değerleri doldur.
# .env.local asla Git'e eklenmez.

# Zorunlu — ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# İsteğe bağlı — kalıcı kullanım limiti (Upstash Redis). Boşsa bellek içi sayaç kullanılır.
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_SALT=
GLOBAL_DAILY_LIMIT=400

# İsteğe bağlı — paylaşım görselleri için sitenin adresi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yerelde kullanım limitini test etmek için yorumu kaldır
# FORCE_RATE_LIMIT=1
